# Скопируйте в .env и правьте. После изменений: docker compose up -d --force-recreate
# или перезапустите python -m shotcore

# --- Веб-страница ---
WEB_HOST=0.0.0.0
WEB_PORT=4861
# Если задать — страница откроется только с ?token=... или заголовком X-Shot-Token
WEB_TOKEN=

# --- Авторизация UI (логин) ---
# off | local | ldap. При local/ldap браузер требует вход; API-клиенты могут использовать WEB_TOKEN.
AUTH_MODE=off
# Секрет подписи cookie-сессии (желательно задать). Иначе берётся WEB_TOKEN.
SESSION_SECRET=
SESSION_TTL_HOURS=12
# Локальные пользователи: user:pass,user2:pass2
AUTH_USERS=
# Токен для API/ShotTrader (X-Shot-Token). Если пусто при AUTH_MODE — берётся SESSION_SECRET.
AUTH_API_TOKEN=
# LDAP (AUTH_MODE=ldap)
LDAP_URL=
# ldap://dc.example.com:389  или  ldaps://dc.example.com:636
LDAP_BASE_DN=
# dc=example,dc=com
LDAP_BIND_DN=
LDAP_BIND_PASSWORD=
# Фильтр поиска пользователя. {username} подставится.
LDAP_USER_FILTER=(sAMAccountName={username})
# Или прямой DN/UPN без поиска, например: {username}@example.com
LDAP_USER_DN_TEMPLATE=
LDAP_START_TLS=false
# Опционально: подстрока в memberOf
LDAP_REQUIRE_GROUP=
LDAP_TIMEOUT_SEC=8

# URL терминала ShotTrader (вкладка на дашборде). Пусто = http://этот-хост:4863/
SHOTTRADER_URL=

# --- Время ---
TZ=Europe/Moscow
# Окно статистики на странице, минуты. 0 = вся история
STATS_LOOKBACK_MIN=180
MARKET_REFRESH_SEC=15
SHOT_WINDOWS_MS=500,700,1200
SHOT_MIN_PERCENT=0.80
SHOT_MIN_TRADES=2
SHOT_MIN_QUOTE_VOLUME=200
SHOT_COOLDOWN_MS=2500
SHOT_RECOVER_RATIO=0.35
SHOT_REFRACTORY_MS=1000
BTC_SYMBOL=BTC-USDT-SWAP
BTC_WINDOW_SEC=60
BTC_RANGE_PCT=0.6

# --- Стратегия: лимит заранее, выход через HOLD_MS ---
HOLD_MS=300
DISTANCE_LEVELS=1.11,1.32,1.42,1.63,1.78
TP_MIN_PCT=0.3
VPLUS_MIN_PNL=0.3
SUGGEST_INSIDE_PCT=0.05

# --- Фильтры рынка (как в MoonTrader Shot) ---
INST_TYPE=SWAP
QUOTE=USDT
QAV_24H_MIN=5000000
QAV_24H_MAX=2000000000
TICK_SIZE_PCT_MAX=0.25
MARK_DEV_PCT_MAX=2.0
MIN_LEVERAGE=20
MAX_LEVERAGE=100
ACTIVE_MAX_MARKETS=25
ACTIVE_IGNORE_FIRST=2
ACTIVE_SORT_SEC=15
# Только часовая дельта. 15м оΔ выключена.
ACTIVE_FILTER_1H=true
ACTIVE_FILTER_15M=false
# Пусто = все пары, прошедшие фильтры. Иначе список через запятую:
# WHITELIST=SOL-USDT-SWAP,DOGE-USDT-SWAP,PEPE-USDT-SWAP
WHITELIST=
BLACKLIST=

# --- Хранение (24 часа) ---
RETENTION_HOURS=24
RETENTION_CLEANUP_SEC=3600

# Снимок для ядра MoonTrader: пара / рекомендация / TP, запуск алгоритма на N часов
MT_PLAN_NAME=mt_plan.json
MT_RUN_HOURS=3

# --- Токены уведомлений (необязательно) ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
TELEGRAM_MIN_PERCENT=1.30

# --- Биржа ---
OKX_REST=https://www.okx.com
OKX_WS=wss://ws.okx.com:8443/ws/v5/public
