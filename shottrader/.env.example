# ShotTrader — свой терминал Shot Group (рядом с ShotCore).
# По умолчанию эмуляция. LIVE только при LIVE_TRADING=true и ключах OKX.

EMULATE=true
LIVE_TRADING=false
TRADER_HOST=0.0.0.0
TRADER_PORT=4863

# Авторизация UI (те же переменные, что у ShotCore)
# off | local | ldap
AUTH_MODE=off
SESSION_SECRET=
SESSION_TTL_HOURS=12
AUTH_USERS=
# Опциональный machine-token (как WEB_TOKEN у ShotCore)
WEB_TOKEN=
LDAP_URL=
LDAP_BASE_DN=
LDAP_BIND_DN=
LDAP_BIND_PASSWORD=
LDAP_USER_FILTER=(sAMAccountName={username})
LDAP_USER_DN_TEMPLATE=
LDAP_START_TLS=false
LDAP_REQUIRE_GROUP=
LDAP_TIMEOUT_SEC=8

# Разведка (ShotCore) — тот же IP, что в браузере у дашборда (не 127.0.0.1, если ShotCore на другой машине)
SHOTCORE_URL=http://127.0.0.1:4861
# При AUTH_MODE на ShotCore — тот же секрет, что WEB_TOKEN / SESSION_SECRET / AUTH_API_TOKEN у ядра
SHOTCORE_TOKEN=
# Альтернатива: WEB_TOKEN=... или SESSION_SECRET=... (подхватится автоматически)
LOOKBACK_MIN=180
TRADER_POLL_SEC=60

# Стратегия
MT_RUN_HOURS=3
HOLD_MS=300
FOLLOW_DELAY_MS=1000
MARGIN_USDT=10
DEFAULT_LEVERAGE=50
AUTOSTOP_USD=10

# Отчёты (час / сутки)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Биржа (нужны только для LIVE)
OKX_REST=https://www.okx.com
OKX_WS=wss://ws.okx.com:8443/ws/v5/public
OKX_API_KEY=
OKX_SECRET_KEY=
OKX_PASSPHRASE=
# true = demo trading OKX
OKX_SIMULATED=false

TZ=Europe/Moscow
TRADER_DATA_DIR=data
