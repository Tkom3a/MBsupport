# ShotTrader — свой терминал Shot Group (рядом с ShotCore).
# По умолчанию эмуляция. LIVE только при LIVE_TRADING=true и ключах OKX.

EMULATE=true
LIVE_TRADING=false
TRADER_HOST=0.0.0.0
TRADER_PORT=4863

# Авторизация UI ShotTrader (не путать с токеном ShotCore):
# AUTH_MODE=off|local|ldap — логин/LDAP
# TRADER_TOKEN=... — только если хотите закрыть страницу токеном (иначе страница открыта)
AUTH_MODE=off
TRADER_TOKEN=

# Токен для запроса плана у ShotCore (если на ядре AUTH / WEB_TOKEN):
SHOTCORE_URL=http://127.0.0.1:4861
SHOTCORE_TOKEN=
LOOKBACK_MIN=180
TRADER_POLL_SEC=60

# Стратегия
MT_RUN_HOURS=3
HOLD_MS=300
FOLLOW_DELAY_MS=1000
MARGIN_USDT=10
DEFAULT_LEVERAGE=50
AUTOSTOP_USD=10

# Отчёты (час / сутки)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Биржа (нужны только для LIVE)
OKX_REST=https://www.okx.com
OKX_WS=wss://ws.okx.com:8443/ws/v5/public
OKX_API_KEY=
OKX_SECRET_KEY=
OKX_PASSPHRASE=
# true = demo trading OKX
OKX_SIMULATED=false

TZ=Europe/Moscow
TRADER_DATA_DIR=data
