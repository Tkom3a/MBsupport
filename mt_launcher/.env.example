# Скопируйте в .env рядом с launcher.py и правьте под свой сервер.

# --- ShotCore (другой сервер, дашборд :4861) ---
# Не оставляйте 127.0.0.1, если MoonTrader и ShotCore на разных машинах.
SHOTCORE_URL=http://IP-сервера-ShotCore:4861
# Если на дашборде задан WEB_TOKEN:
SHOTCORE_TOKEN=

# Только пары из текущих активных рынков ShotCore (1ч Δ). false = все из плана.
SUBSCRIBED_ONLY=true
# Не ставить BTC.
SKIP_BTC=true
# Сколько пар максимум за один запуск.
MT_MAX_PAIRS=25

# --- MoonTrader на этой машине ---
# Профиль ядра, как папка в moontrader-data/data/
MT_PROFILE=okxoma
# Если путь другой — укажите файл целиком (тогда MT_PROFILE не нужен):
# MT_ALGOS_PATH=/root/.config/moontrader-data/data/okxoma/algorithms.config
MT_ALGOS_PATH=
# Имя папки в списке алгоритмов клиента:
MT_FOLDER=MBsupport
# Имя существующего Shot Group, с которого копируем все настройки.
# Пусто = первый алгоритм с подписью SG.
MT_TEMPLATE=

# Число в поле Order size Shot. Справка MT: это уже номинал с плечом.
# 10 = ордер на $10 (ядро само ставит макс. плечо пары x20/x50).
MARGIN_USDT=10
# Если в плане нет плеча (фильтр max leverage):
DEFAULT_LEVERAGE=20

# Префикс имени, чтобы скрипт трогал только свои алгоритмы.
ALGO_PREFIX=SC
# Сколько часов жить клону. Watch сам снимет по таймеру, если MT не удалил.
RUN_HOURS=3
# Как на веб-морде: 1440 = 24 часа. Иначе D/TP не совпадут с таблицей.
LOOKBACK_MIN=1440
# Как часто сверять таблицу ShotCore и клоны MT.
POLL_SEC=15
# Каталог профиля ядра (docker compose volume на хосте):
MT_DATA_DIR=/root/.config/moontrader-data/data/okxoma

# true = только показать, что будет сделано, файл MT не менять.
DRY_RUN=false
