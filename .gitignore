.envrc
.env.local
.env.production
.env.live
.env.bak
.env.save
.env.old
.env.copy
*.env.bak
*.env.old
*.env.save
secrets.env
.env.txt
env.txt

# Копии, которые делают Windows / редакторы
*.env.copy
* copy.env
Copy of .env

